generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id          String     @id @default(cuid())
  email       String     @unique
  displayName String
  passwordHash String?
  role        UserRole   @default(USER)
  status      UserStatus @default(PENDING)
  isTestAccount Boolean  @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  profile     Profile?
  sessions    Session[]
  listings    Listing[]
  likesSent   Like[]        @relation("LikeSender")
  likesReceived Like[]      @relation("LikeReceiver")
  matchesAsFirst Match[]    @relation("MatchFirstUser")
  matchesAsSecond Match[]   @relation("MatchSecondUser")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Profile {
  id          String  @id @default(cuid())
  userId      String  @unique
  bio         String?
  city        String?
  budgetMin   Int?
  budgetMax   Int?
  preferences Json?
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum ListingStatus {
  ACTIVE
  RENTED
  ARCHIVED
}

model Listing {
  id            String        @id @default(cuid())
  title         String
  description   String
  city          String
  neighborhood  String?
  monthlyRent   Int
  deposit       Int?
  bedrooms      Int           @default(1)
  furnished     Boolean       @default(false)
  availableFrom DateTime
  status        ListingStatus @default(ACTIVE)
  ownerId       String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  owner         User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([status, city])
  @@index([monthlyRent])
  @@index([ownerId])
}

model Like {
  id         String   @id @default(cuid())
  fromUserId String
  toUserId   String
  createdAt  DateTime @default(now())
  fromUser   User     @relation("LikeSender", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser     User     @relation("LikeReceiver", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@index([toUserId])
}

model Match {
  id         String   @id @default(cuid())
  firstUserId  String
  secondUserId String
  createdAt  DateTime @default(now())
  firstUser  User     @relation("MatchFirstUser", fields: [firstUserId], references: [id], onDelete: Cascade)
  secondUser User     @relation("MatchSecondUser", fields: [secondUserId], references: [id], onDelete: Cascade)

  @@unique([firstUserId, secondUserId])
  @@index([secondUserId])
}
